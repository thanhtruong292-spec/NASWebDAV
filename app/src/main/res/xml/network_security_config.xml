<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Cleartext HTTP chỉ cho phép tới NAS đã biết: LAN + Tailscale (IP cố định). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.100.254</domain>
        <domain includeSubdomains="false">100.90.135.102</domain>
    </domain-config>
</network-security-config>
